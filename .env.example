# Database Configuration
DB_USER=bunker
DB_PASSWORD=your_secure_password_here
DB_NAME=bunker_db

# DATABASE_URL is auto-generated in docker-compose.yml from the above variables
# Only needed for local development without Docker:
# DATABASE_URL=postgresql://bunker:your_secure_password_here@localhost:5432/bunker_db

# Admin User (created on first startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password_here

# Session Secret (generate a random string)
SESSION_SECRET=your_random_session_secret_here

# Port (optional, defaults to 80)
PORT=80
